# AVCU server environment template. Replace placeholders in the deployment secret store.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/avcu

# Gmail API OAuth (server-side only; never commit real values)
AVCU_GMAIL_CLIENT_ID=
AVCU_GMAIL_CLIENT_SECRET=
AVCU_GMAIL_REFRESH_TOKEN=
AVCU_GMAIL_FROM=

# Operations email destination and absolute URL used in loan alerts
AVCU_OPERATIONS_EMAIL=
AVCU_PUBLIC_BASE_URL=
